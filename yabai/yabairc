#!/usr/bin/env sh

# ── Scripting Addition ────────────────────────────────────────────────────────
# Reload the scripting addition whenever Dock restarts (required for some features)
# The sudoers rule pins the binary's sha256: after every `brew upgrade yabai`, regenerate it with
#   echo "$(whoami) ALL=(root) NOPASSWD: sha256:$(shasum -a 256 $(which yabai) | cut -d " " -f 1) $(which yabai) --load-sa" | sudo tee /private/etc/sudoers.d/yabai
yabai -m signal --add label=load_sa event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# ── Bar ───────────────────────────────────────────────────────────────────────
yabai -m config external_bar all:34:0

# ── Layout ────────────────────────────────────────────────────────────────────
yabai -m config layout           bsp
yabai -m config window_placement second_child
yabai -m config split_ratio      0.5
# auto_balance off: preserves manual split ratios; use shift+alt-b to rebalance on demand
yabai -m config auto_balance     off

# ── Gaps & Padding ────────────────────────────────────────────────────────────
yabai -m config top_padding    0
yabai -m config bottom_padding 0
yabai -m config left_padding   0
yabai -m config right_padding  0
yabai -m config window_gap     2

# ── Mouse ─────────────────────────────────────────────────────────────────────
# autofocus: window under cursor gets focus without being raised (less disruptive than autoraise)
yabai -m config focus_follows_mouse autofocus
yabai -m config mouse_modifier      alt
yabai -m config mouse_action1       move
yabai -m config mouse_action2       resize
yabai -m config mouse_drop_action   swap

# ── Window Appearance ─────────────────────────────────────────────────────────
yabai -m config window_shadow           on
yabai -m config window_opacity          on
yabai -m config active_window_opacity   1.0
yabai -m config normal_window_opacity   0.95
yabai -m config window_opacity_duration 0.0

# ── Animations ────────────────────────────────────────────────────────────────
yabai -m config window_animation_duration 0.0
yabai -m config window_origin_display     focused

# ── Float Rules ───────────────────────────────────────────────────────────────
yabai -m rule --add app="^System Settings$"  manage=off
yabai -m rule --add app="^Calculator$"       manage=off
yabai -m rule --add app="^Activity Monitor$" manage=off
yabai -m rule --add app="^Finder$"           manage=off
yabai -m rule --add app="^QuickTime Player$" manage=off
yabai -m rule --add app="^FaceTime$"         manage=off

# ── Space Assignment ──────────────────────────────────────────────────────────
yabai -m rule --add app="^Discord$" space=6

# ── Second Display ────────────────────────────────────────────────────────────
# Spaces 9 and 10 (alt-9 / alt-0) live on the second display, created as soon
# as it is plugged in. macOS rearranges spaces right after the display shows
# up, hence the short delay.
yabai -m signal --add label=arrange_spaces event=display_added \
    action="sleep 1; $HOME/.config/yabai/arrange_spaces.sh"
"$HOME/.config/yabai/arrange_spaces.sh"

# Pointer helper used by focus_space.sh (alt-<n>)
make -C "$HOME/.config/yabai/helpers" >/dev/null

# ── SketchyBar Refresh Signals ────────────────────────────────────────────────
# These signals are the only source of the bar's space icons (with skhd, which
# triggers the refresh after moving a window to another space). sketchybar's
# own space_windows_change isn't used: it fires before yabai has updated its
# window list, misses some apps (Claude Desktop, Preview), and makes sketchybar
# track every window through the WindowServer. yabai signals run once its
# state is up to date.
# Each signal starts a process, so only events that change the icons count:
# window_moved fires continuously during a drag, and application_launched
# comes before the app has any window (window_created follows). A window
# entering or leaving native fullscreen moves to or from a space of its own:
# space_created / space_destroyed cover it.
# Labels make the signals idempotent if this file is sourced again without a restart.
yabai -m signal --remove sketchybar_application_launched 2>/dev/null
for event in window_created window_destroyed window_minimized window_deminimized \
             application_terminated application_hidden application_visible \
             space_created space_destroyed; do
    yabai -m signal --add label="sketchybar_$event" event="$event" \
        action="sketchybar --trigger force_space_refresh"
done

# ── Apply Rules ───────────────────────────────────────────────────────────────
# Rules only affect new windows unless applied explicitly (e.g. after a yabai restart)
yabai -m rule --apply

# ── Initial Bar Refresh ───────────────────────────────────────────────────────
# At login sketchybar usually starts before yabai can answer, so its first
# query finds nothing: fill in the space icons as soon as yabai is ready
sketchybar --trigger force_space_refresh 2>/dev/null
